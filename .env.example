# Copy to .env, fill in, run ./install.sh. .env never leaves your machine.
# Account names: lowercase letters only, each with its three lines below.
HOP_ACCOUNTS="acme wombat"
# Active account on first install.
HOP_DEFAULT=acme
# Account that signs commits in this repo. Empty: the active one.
HOP_REPO_ACCOUNT=wombat
# Repos under this folder always use HOP_WORK_ACCOUNT. Empty: no rule.
HOP_WORK_DIR="~/code/acme/"
HOP_WORK_ACCOUNT=acme

ACME_EMAIL=wile@acme.example
ACME_SSH_KEY="~/.ssh/id_ed25519_acme"
ACME_GITHUB=wile-acme

WOMBAT_EMAIL=sleepy@wombat.example
WOMBAT_SSH_KEY="~/.ssh/id_ed25519"
WOMBAT_GITHUB=sleepy-wombat
