# install.sh asks these questions and writes .env. Or copy this file to .env,
# fill it in, run ./install.sh. .env never leaves your machine.
# Account names: lowercase letters only, each with its three lines below.
HOP_ACCOUNTS="acme wombat"
# Active account on first install.
HOP_DEFAULT=acme
# Account that signs commits in this repo (install.sh writes its .hop).
# Empty: the active one.
HOP_REPO_ACCOUNT=wombat
# Repos under this folder always use HOP_WORK_ACCOUNT: install.sh puts a .hop
# file there for shells, and an includeIf for git started elsewhere. Empty: no
# rule. More folders: one .hop file in each, holding the account name.
HOP_WORK_DIR="~/code/acme/"
HOP_WORK_ACCOUNT=acme
# 1: each account also gets its own Claude Code login, in ~/.claude-<account>,
# switched with the folder like the rest. Needs jq. Empty: Claude untouched.
HOP_CLAUDE=

ACME_EMAIL=wile@acme.example
ACME_SSH_KEY="~/.ssh/id_ed25519_acme"
ACME_GITHUB=wile-acme

WOMBAT_EMAIL=sleepy@wombat.example
WOMBAT_SSH_KEY="~/.ssh/id_ed25519"
WOMBAT_GITHUB=sleepy-wombat
