#!/bin/bash
# Switch the default GitHub account for git and gh, and the secrets tied to it.
# Accounts are the profiles install.sh writes from .env. Only the
# ~/.gitconfig-active include and gh's active account are changed. With
# HOP_ACTIVE naming another include (one shell's), only that file changes and
# gh keeps its account: the caller exports GH_TOKEN. Secret
# values live in the macOS Keychain, or elsewhere in <account>.secrets next
# to the profiles, readable by you only. Profiles only list their names.
set -euo pipefail

PROFILES="${HOP_PROFILES:-$HOME/.config/hop}"
GLOBAL_ACTIVE="$HOME/.gitconfig-active"
ACTIVE="${HOP_ACTIVE:-$GLOBAL_ACTIVE}"
GH_HOST="${HOP_GH_HOST:-github.com}"
KEYCHAIN_PREFIX="${HOP_KEYCHAIN_PREFIX:-hop}"
KEYCHAIN=$(command -v security || true)

profiles() {
  for f in "$PROFILES"/*.gitconfig; do basename "$f" .gitconfig; done
}

active_profile() {
  basename "$(git config -f "$ACTIVE" include.path)" .gitconfig
}

require_profile() {
  if [ ! -f "$PROFILES/$1.gitconfig" ]; then
    echo "unknown account: $1 (available: $(profiles | xargs))" >&2
    exit 1
  fi
}

field() {
  git config -f "$PROFILES/$1.gitconfig" "$2"
}

profile_vars() {
  git config -f "$PROFILES/$1.gitconfig" --get-all env.var || true
}

# The account of a folder: the nearest .hop above it, as in hop.sh. An
# account without a hop profile (a client that only lends Claude), or no
# .hop at all, leaves the shell's account.
folder_account() {
  local dir=$1 account=""
  while [ -n "$dir" ]; do
    if [ -f "$dir/.hop" ]; then
      read -r account < "$dir/.hop" || true
      break
    fi
    dir=${dir%/*}
  done
  if [ -z "$account" ] || [ ! -f "$PROFILES/$account.gitconfig" ]; then
    account=${HOP_GH_ACCOUNT:-$(active_profile)}
  fi
  echo "$account"
}

# git runs this before every commit (hook.hop, set by install.sh), next to
# the repo's own hooks.
guard() {
  local account expected author
  account=$(folder_account "$PWD")
  [ -f "$PROFILES/$account.gitconfig" ] || return 0
  expected=$(field "$account" user.email)
  author=$(git var GIT_AUTHOR_IDENT | sed 's/.*<\(.*\)>.*/\1/')
  [ "$author" != "$expected" ] || return 0
  echo "hop: this folder commits as $account <$expected>, not <$author>." >&2
  echo "hop: run hop $account, or git commit --no-verify to skip the check." >&2
  return 1
}

secret_get() {
  if [ -n "$KEYCHAIN" ]; then
    security find-generic-password -a "$USER" -s "$KEYCHAIN_PREFIX:$1:$2" -w 2>/dev/null
  else
    sed -n "s/^$2=//p" "$PROFILES/$1.secrets" 2>/dev/null | grep .
  fi
}

secret_list() {
  local profile=$1 name
  for name in $(profile_vars "$profile"); do
    if secret_get "$profile" "$name" >/dev/null; then
      echo "$name set"
    else
      echo "$name missing"
    fi
  done
}

# One * per character so a paste can be checked; backspace erases.
# Bracketed paste is switched off during the prompt: a terminal that keeps it
# wraps the pasted value in ESC[200~ ... ESC[201~, which ended up stored.
read_secret() {
  local c value="" start=$'\e[200~' end=$'\e[201~'
  printf '%s' "$1" >&2
  printf '\e[?2004l' >&2
  while IFS= read -rsn1 c; do
    case $c in
      "") break ;;
      $'\e')
        # Terminals that ignore the switch still send the paste codes.
        IFS= read -rsn5 c
        case $c in
          "[200~" | "[201~") ;;
          *) value+=$'\e'$c; printf '%*s' $((${#c} + 1)) '' | tr ' ' '*' >&2 ;;
        esac ;;
      $'\x7f' | $'\b')
        if [ -n "$value" ]; then
          value=${value%?}
          printf '\b \b' >&2
        fi ;;
      *) value+=$c; printf '*' >&2 ;;
    esac
  done
  echo >&2
  value=${value//"$start"/}
  value=${value//"$end"/}
  REPLY=$value
}

secret_set() {
  local name=$1 profile=${2:-$(active_profile)} value where
  require_profile "$profile"
  if [[ ! $name =~ ^[A-Z_][A-Z0-9_]*$ ]]; then
    echo "invalid name: $name (UPPERCASE_AND_DIGITS)" >&2
    exit 1
  fi
  read_secret "value of $name for $profile: "
  value=$REPLY
  if [ -z "$value" ] || [[ $value == *[\"\\[:space:]]* ]]; then
    echo "empty value, or one with a quote, backslash or space: nothing stored" >&2
    exit 1
  fi
  if [ -n "$KEYCHAIN" ]; then
    where="the macOS Keychain"
    # Fed through stdin so the value never shows up in the process list.
    printf 'add-generic-password -U -a "%s" -s "%s" -w "%s"\n' \
      "$USER" "$KEYCHAIN_PREFIX:$profile:$name" "$value" | security -i >/dev/null
  else
    where="$PROFILES/$profile.secrets"
    ( umask 077
      { grep -v "^$name=" "$where" 2>/dev/null || true
        printf '%s=%s\n' "$name" "$value"; } > "$where.tmp"
      mv "$where.tmp" "$where" )
  fi
  if ! profile_vars "$profile" | grep -qxF "$name"; then
    git config -f "$PROFILES/$profile.gitconfig" --add env.var "$name"
  fi
  echo "$name stored for $profile in $where."
}

print_env() {
  local profile name value
  profile=$(active_profile)
  # Unset every declared name first so a switch never leaks the other
  # account's values.
  for p in $(profiles); do profile_vars "$p"; done | sort -u | sed 's/^/unset /'
  for name in $(profile_vars "$profile"); do
    if value=$(secret_get "$profile" "$name"); then
      printf 'export %s=%q\n' "$name" "$value"
    fi
  done
}

status() {
  local profile expected ssh_cmd ssh_login gh_active secrets
  profile=$(active_profile)
  expected=$(field "$profile" github.user)
  # One shell's include: its gh runs on the token that shell exports for the
  # account, not yet updated right after hopla switched it.
  if [ "$ACTIVE" != "$GLOBAL_ACTIVE" ]; then
    GH_TOKEN=$(gh auth token -h "$GH_HOST" -u "$expected" 2>/dev/null) \
      || echo "gh: $expected not logged in, run gh auth login" >&2
    export GH_TOKEN
  fi
  ssh_cmd=$(git config core.sshCommand)
  # ssh -T always exits 1 on GitHub, the login is in the greeting.
  ssh_login=$(eval "$ssh_cmd -o ConnectTimeout=5 -T git@$GH_HOST" 2>&1 \
    | sed -n 's/^Hi \([^!]*\)!.*/\1/p' || true)
  gh_active=$(gh auth status --active -h "$GH_HOST" 2>&1 \
    | sed -n 's/.*account \([^ ]*\).*/\1/p' | head -1 || true)
  secrets=$(secret_list "$profile" | paste -sd, - | sed 's/,/, /g')

  echo "Account: $profile"
  echo "Git:     $(git config user.email)"
  echo "Key:     $(echo "$ssh_cmd" | sed -n 's/.*-i \([^ ]*\).*/\1/p')"
  echo "SSH:     ${ssh_login:-connection failed}"
  echo "gh:      ${gh_active:-?}"
  echo "Env:     ${secrets:-no variables}"
  echo
  if [ "$ssh_login" = "$expected" ] && [ "$gh_active" = "$expected" ]; then
    echo "OK: GitHub knows you as $expected."
  else
    echo "WARNING: expected $expected everywhere."
    if [ "$(git config user.email)" != "$(field "$profile" user.email)" ]; then
      echo "This folder forces another account (includeIf or repo config)."
    fi
  fi
}

use() {
  require_profile "$1"
  # A plain include file, not a symlink: Git Bash on Windows copies symlinks.
  rm -f "$ACTIVE"
  git config -f "$ACTIVE" include.path "$PROFILES/$1.gitconfig"
  if [ "$ACTIVE" = "$GLOBAL_ACTIVE" ]; then
    local user
    user=$(field "$1" github.user)
    gh auth switch -h "$GH_HOST" -u "$user" >/dev/null 2>&1 \
      || echo "gh: $user not logged in, run gh auth login" >&2
  fi
  status
}

case "${1:-}" in
  status|s) status ;;
  env) print_env ;;
  guard) guard ;;
  secret)
    case "${2:-ls}" in
      ls|list)
        if [ -n "${3:-}" ]; then
          require_profile "$3"
          secret_list "$3"
        else
          for p in $(profiles); do secret_list "$p" | sed "s/^/$p: /"; done
        fi ;;
      set) secret_set "${3:?usage: hop secret set NAME [account]}" "${4:-}" ;;
      *) echo "usage: hop secret [list|set NAME] [account]" >&2; exit 1 ;;
    esac
    ;;
  ui)
    if ! command -v hopla >/dev/null; then
      echo "hopla is not installed:" >&2
      echo "  curl -fsSL https://raw.githubusercontent.com/mirkobozzetto/hopla/main/install.sh | sh" >&2
      exit 1
    fi
    # hopla switches and creates accounts through this hop and its .env.
    HOP_BIN="$0" HOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)" exec hopla
    ;;
  "")
    status
    echo
    current=$(active_profile)
    choices=$(echo "$current"; profiles | grep -vxF "$current")
    if command -v fzf >/dev/null; then
      # Esc makes fzf exit non-zero: leave without switching.
      choice=$(echo "$choices" \
        | fzf --reverse --height=~10 --no-info --prompt="account > " \
            --header="current: $current · ↑↓ choose · Enter select · Esc quit") \
        || exit 0
    else
      PS3="account (number, Ctrl-D to quit) > "
      select choice in $choices; do [ -n "$choice" ] && break; done
      [ -n "${choice:-}" ] || exit 0
    fi
    [ "$choice" = "$current" ] || { echo; use "$choice"; }
    ;;
  *) use "$1" ;;
esac
